# .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)
# Vercel에는 Settings > Environment Variables 에 넣고 재배포하세요.

# 조회용 — Supabase 대시보드 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 비밀 키 (Supabase > API > service_role) — 쓰기 · 관리자 메모 조회에 사용
# NEXT_PUBLIC_ 붙이지 말 것, 채팅 · 깃허브에 올리지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# 로그인 세션 서명용 비밀 값 (32자 이상 아무 랜덤 문자열). 로컬과 Vercel에 각각 넣는다. 바꾸면 모두 로그아웃됨
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# SOOP Open API (대문 클랜 BJ 방송 상태) — developers.sooplive.co.kr > 내 프로그램 > 애플리케이션 "TuF Clan"
# 없으면 BJ는 모두 '오프라인'으로 표시됨. 시크릿은 지금 코드에서 안 쓰지만 보관용으로 같이 넣어둔다
SOOP_CLIENT_ID=
SOOP_CLIENT_SECRET=

# 구글 시트 연동 (/api/sheets-sync) — Apps Script가 'Authorization: Bearer <값>'으로 보내는 비밀 값
# 기존 tufelo Vercel 프로젝트의 SHEETS_SYNC_SECRET 과 같은 값을 넣으면 Apps Script는 주소만 바꾸면 된다. 로컬은 시험할 때만
SHEETS_SYNC_SECRET=

# 데이터센터 › 런처 사용 '전적 중 런처로 입력' 비율 — 구글 시트 Apps Script 웹 앱 주소 (?action=launcher_stats로 부름)
# 기존 tufelo Vercel 프로젝트의 LAUNCHER_STATS_APPS_SCRIPT_URL 과 같은 값. 없으면 그 칸만 '불러올 수 없어요'
LAUNCHER_STATS_APPS_SCRIPT_URL=

# 다른 사이트 → ELO 전적 1건 등록 (/api/clan-share) — 보내는 쪽이 'Authorization: Bearer <값>'으로 보내는 비밀 값
# 기존 tufelo Vercel 프로젝트의 CLAN_API_KEY 와 같은 값. 없으면 /api/clan-share 는 전부 401
CLAN_API_KEY=

# 로컬 개발 전용: 값이 있으면 `npm run dev`에서만 로그인 없이 관리자 기능 사용 (배포에서는 무시됨)
# 관리자 로그(admin_logs)에 이 이름으로 기록됩니다. ⚠️ 로컬에서도 실제 DB가 바뀝니다.
# DEV_ADMIN_USERNAME=
